NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/thinkcrm

JWT_ACCESS_SECRET=a_very_secure_and_long_jwt_access_secret_key_12345
JWT_REFRESH_SECRET=a_very_secure_and_long_jwt_refresh_secret_key_12345
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP config for Mailtrap (or test server)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_smtp_user
SMTP_PASSWORD=test_smtp_password
EMAIL_FROM=noreply@thinkcrm.com

# Cloudinary test values
CLOUDINARY_CLOUD_NAME=test_cloud_name
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret

# Meta integration test values
META_APP_ID=test_meta_app_id
META_APP_SECRET=test_meta_app_secret
META_ACCESS_TOKEN=test_meta_access_token
META_VERIFY_TOKEN=test_meta_verify_token
